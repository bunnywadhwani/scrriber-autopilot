# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_SECRET_KEY=change-me-to-a-secure-random-key

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/scrriber_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Cloudflare R2 Storage (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=scrriber-assets
R2_PUBLIC_DOMAIN=

# Meta Instagram Graph API
META_APP_ID=
META_APP_SECRET=
META_USER_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# AI Intelligence Providers
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
